# serializer version: 1
# name: TestTracesQueryRunner.test_field_mapping
  '''
  SELECT groupArray(trace_id) AS trace_ids,
         min(first_ts) AS min_timestamp,
         max(last_ts) AS max_timestamp
  FROM
    (SELECT ai_events.trace_id AS trace_id,
            min(toTimeZone(ai_events.timestamp, 'UTC')) AS first_ts,
            max(toTimeZone(ai_events.timestamp, 'UTC')) AS last_ts
     FROM ai_events
     WHERE and(equals(ai_events.team_id, 99999), in(ai_events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(notEquals(ai_events.trace_id, ''), and(greaterOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-08 23:50:00', 'UTC'))), lessOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-16 00:10:59', 'UTC'))))))
     GROUP BY ai_events.trace_id
     ORDER BY min(toTimeZone(ai_events.timestamp, 'UTC')) DESC
     LIMIT 101)
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
# ---
# name: TestTracesQueryRunner.test_field_mapping.1
  '''
  SELECT groupArray(trace_id) AS trace_ids,
         min(first_ts) AS min_timestamp,
         max(last_ts) AS max_timestamp
  FROM
    (SELECT ai_events.trace_id AS trace_id,
            min(ai_events.timestamp) AS first_ts,
            max(ai_events.timestamp) AS last_ts
     FROM
       (SELECT events.uuid AS uuid,
               events.event AS event,
               toTimeZone(events.timestamp, 'UTC') AS timestamp,
               events.team_id AS team_id,
               events.distinct_id AS distinct_id,
               if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id) AS person_id,
               events.properties AS properties,
               JSONExtractString(events.properties, '$ai_trace_id') AS trace_id,
               JSONExtractString(events.properties, '$ai_session_id') AS session_id,
               JSONExtractString(events.properties, '$ai_parent_id') AS parent_id,
               JSONExtractString(events.properties, '$ai_span_id') AS span_id,
               JSONExtractString(events.properties, '$ai_generation_id') AS generation_id,
               JSONExtractString(events.properties, '$ai_span_name') AS span_name,
               JSONExtractString(events.properties, '$ai_trace_name') AS trace_name,
               JSONExtractInt(events.properties, '$ai_input_tokens') AS input_tokens,
               JSONExtractInt(events.properties, '$ai_output_tokens') AS output_tokens,
               JSONExtractFloat(events.properties, '$ai_input_cost_usd') AS input_cost_usd,
               JSONExtractFloat(events.properties, '$ai_output_cost_usd') AS output_cost_usd,
               JSONExtractFloat(events.properties, '$ai_total_cost_usd') AS total_cost_usd,
               JSONExtractFloat(events.properties, '$ai_latency') AS latency,
               if(equals(JSONExtractString(events.properties, '$ai_is_error'), 'true'), 1, 0) AS is_error,
               JSONExtractString(events.properties, '$ai_error_normalized') AS error_normalized,
               JSONExtractRaw(events.properties, '$ai_input') AS input,
               JSONExtractRaw(events.properties, '$ai_output') AS output,
               JSONExtractRaw(events.properties, '$ai_output_choices') AS output_choices,
               JSONExtractRaw(events.properties, '$ai_input_state') AS input_state,
               JSONExtractRaw(events.properties, '$ai_output_state') AS output_state,
               JSONExtractRaw(events.properties, '$ai_tools') AS tools
        FROM events
        LEFT OUTER JOIN
          (SELECT tupleElement(argMax(tuple(person_distinct_id_overrides.person_id), person_distinct_id_overrides.version), 1) AS person_id,
                  person_distinct_id_overrides.distinct_id AS distinct_id
           FROM person_distinct_id_overrides
           WHERE equals(person_distinct_id_overrides.team_id, 99999)
           GROUP BY person_distinct_id_overrides.distinct_id
           HAVING ifNull(equals(tupleElement(argMax(tuple(person_distinct_id_overrides.is_deleted), person_distinct_id_overrides.version), 1), 0), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
        WHERE and(equals(events.team_id, 99999), in(events.event, tuple('$ai_generation', '$ai_span', '$ai_trace', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_evaluation')))) AS ai_events
     WHERE and(in(ai_events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(ifNull(notEquals(ai_events.trace_id, ''), 1), and(ifNull(greaterOrEquals(ai_events.timestamp, assumeNotNull(toDateTime('2025-01-08 23:50:00', 'UTC'))), 0), ifNull(lessOrEquals(ai_events.timestamp, assumeNotNull(toDateTime('2025-01-16 00:10:59', 'UTC'))), 0)), notIn(ai_events.trace_id, tuple('trace1', 'trace2'))))
     GROUP BY ai_events.trace_id
     ORDER BY min(ai_events.timestamp) DESC
     LIMIT 101)
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
# ---
# name: TestTracesQueryRunner.test_field_mapping.2
  '''
  SELECT ai_events.trace_id AS id,
         any(ai_events.session_id) AS ai_session_id,
         min(toTimeZone(ai_events.timestamp, 'UTC')) AS first_timestamp,
         ifNull(nullIf(argMinIf(ai_events.distinct_id, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')), ''), argMin(ai_events.distinct_id, toTimeZone(ai_events.timestamp, 'UTC'))) AS first_distinct_id,
         round(if(and(ifNull(equals(countIf(and(greater(ai_events.latency, 0), notEquals(ai_events.event, '$ai_generation'))), 0), 0), ifNull(greater(countIf(and(greater(ai_events.latency, 0), equals(ai_events.event, '$ai_generation'))), 0), 0)), sumIf(ai_events.latency, and(equals(ai_events.event, '$ai_generation'), greater(ai_events.latency, 0))), sumIf(ai_events.latency, or(equals(ai_events.parent_id, ''), equals(ai_events.parent_id, ai_events.trace_id)))), 2) AS total_latency,
         sumIf(ai_events.input_tokens, in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))) AS input_tokens,
         sumIf(ai_events.output_tokens, in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))) AS output_tokens,
         round(sumIf(ai_events.input_cost_usd, in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS input_cost,
         round(sumIf(ai_events.output_cost_usd, in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS output_cost,
         round(sumIf(ai_events.total_cost_usd, in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS total_cost,
         arrayDistinct(arraySort(x -> x.3, groupArrayIf(tuple(ai_events.uuid, ai_events.event, toTimeZone(ai_events.timestamp, 'UTC'), ai_events.properties, ai_events.input, ai_events.output, ai_events.output_choices, ai_events.input_state, ai_events.output_state, ai_events.tools), or(in(ai_events.event, tuple('$ai_metric', '$ai_feedback')), equals(ai_events.parent_id, ai_events.trace_id))))) AS events,
         argMinIf(ai_events.input_state, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')) AS input_state,
         argMinIf(ai_events.output_state, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')) AS output_state,
         ifNull(argMinIf(ifNull(nullIf(ai_events.span_name, ''), nullIf(ai_events.trace_name, '')), toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')), argMin(ifNull(nullIf(ai_events.span_name, ''), nullIf(ai_events.trace_name, '')), toTimeZone(ai_events.timestamp, 'UTC'))) AS trace_name,
         countIf(equals(ai_events.is_error, 1)) AS error_count,
         any(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, 'ai_support_impersonated'), ''), 'null'), '^"|"$', '')) AS is_support_trace,
         arrayFilter(x -> ifNull(notEquals(x, ''), 1), arrayDistinct(splitByChar(',', arrayStringConcat(groupArrayIf(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), and(equals(ai_events.event, '$ai_generation'), isNotNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), ifNull(notEquals(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), ''), 1))), ',')))) AS tools
  FROM ai_events
  WHERE and(equals(ai_events.team_id, 99999), and(in(ai_events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(greaterOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-13 23:50:00', 'UTC'))), lessOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-15 01:10:00', 'UTC'))))), in(ai_events.trace_id, tuple('trace1', 'trace2')))
  GROUP BY ai_events.trace_id
  ORDER BY first_timestamp DESC
  LIMIT 101
  OFFSET 0 SETTINGS readonly=2,
                    max_execution_time=60,
                    allow_experimental_object_type=1,
                    max_ast_elements=4000000,
                    max_expanded_ast_elements=4000000,
                    max_bytes_before_external_group_by=0,
                    transform_null_in=1,
                    optimize_min_equality_disjunction_chain_length=4294967295,
                    allow_experimental_join_condition=1,
                    use_hive_partitioning=0
  '''
# ---
# name: TestTracesQueryRunner.test_group_key_filter
  '''
  SELECT groupArray(trace_id) AS trace_ids,
         min(first_ts) AS min_timestamp,
         max(last_ts) AS max_timestamp
  FROM
    (SELECT replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', '') AS trace_id,
            min(toTimeZone(ai_events.timestamp, 'UTC')) AS first_ts,
            max(toTimeZone(ai_events.timestamp, 'UTC')) AS last_ts
     FROM ai_events
     WHERE and(equals(ai_events.team_id, 99999), in(ai_events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(isNotNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', '')), ifNull(notEquals(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', ''), ''), 1), and(greaterOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-08 23:50:00', 'UTC'))), lessOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-16 00:10:59', 'UTC'))))))
     GROUP BY trace_id
     ORDER BY min(toTimeZone(ai_events.timestamp, 'UTC')) DESC
     LIMIT 101)
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
# ---
# name: TestTracesQueryRunner.test_group_key_filter.1
  '''
  SELECT replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', '') AS id,
         any(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_session_id'), ''), 'null'), '^"|"$', '')) AS ai_session_id,
         min(toTimeZone(ai_events.timestamp, 'UTC')) AS first_timestamp,
         ifNull(nullIf(argMinIf(ai_events.distinct_id, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')), ''), argMin(ai_events.distinct_id, toTimeZone(ai_events.timestamp, 'UTC'))) AS first_distinct_id,
         round(if(and(ifNull(equals(countIf(and(ifNull(greater(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_latency'), ''), 'null'), '^"|"$', ''), 'Float64'), 0), 0), notEquals(ai_events.event, '$ai_generation'))), 0), 0), ifNull(greater(countIf(and(ifNull(greater(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_latency'), ''), 'null'), '^"|"$', ''), 'Float64'), 0), 0), equals(ai_events.event, '$ai_generation'))), 0), 0)), sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_latency'), ''), 'null'), '^"|"$', ''), 'Float64'), and(equals(ai_events.event, '$ai_generation'), ifNull(greater(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_latency'), ''), 'null'), '^"|"$', ''), 'Float64'), 0), 0))), sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_latency'), ''), 'null'), '^"|"$', ''), 'Float64'), or(isNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_parent_id'), ''), 'null'), '^"|"$', '')), ifNull(equals(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_parent_id'), ''), 'null'), '^"|"$', '')), toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', ''))), isNull(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_parent_id'), ''), 'null'), '^"|"$', '')))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          and isNull(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', ''))))))), 2) AS total_latency,
         sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_input_tokens'), ''), 'null'), '^"|"$', ''), 'Float64'), in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))) AS input_tokens,
         sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_output_tokens'), ''), 'null'), '^"|"$', ''), 'Float64'), in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))) AS output_tokens,
         round(sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_input_cost_usd'), ''), 'null'), '^"|"$', ''), 'Float64'), in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS input_cost,
         round(sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_output_cost_usd'), ''), 'null'), '^"|"$', ''), 'Float64'), in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS output_cost,
         round(sumIf(accurateCastOrNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_total_cost_usd'), ''), 'null'), '^"|"$', ''), 'Float64'), in(ai_events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS total_cost,
         arrayDistinct(arraySort(x -> x.3, groupArrayIf(tuple(ai_events.uuid, ai_events.event, toTimeZone(ai_events.timestamp, 'UTC'), ai_events.properties), or(in(ai_events.event, tuple('$ai_metric', '$ai_feedback')), ifNull(equals(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_parent_id'), ''), 'null'), '^"|"$', '')), toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', ''))), isNull(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_parent_id'), ''), 'null'), '^"|"$', '')))
                                                                                                                                                                                                                                  and isNull(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', '')))))))) AS events,
         argMinIf(ai_events.input_state, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')) AS input_state,
         argMinIf(ai_events.output_state, toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')) AS output_state,
         ifNull(argMinIf(ifNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_span_name'), ''), 'null'), '^"|"$', ''), replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_name'), ''), 'null'), '^"|"$', '')), toTimeZone(ai_events.timestamp, 'UTC'), equals(ai_events.event, '$ai_trace')), argMin(ifNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_span_name'), ''), 'null'), '^"|"$', ''), replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_name'), ''), 'null'), '^"|"$', '')), toTimeZone(ai_events.timestamp, 'UTC'))) AS trace_name,
         countIf(or(isNotNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_error'), ''), 'null'), '^"|"$', '')), ifNull(equals(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_is_error'), ''), 'null'), '^"|"$', ''), 'true'), 0))) AS error_count,
         any(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, 'ai_support_impersonated'), ''), 'null'), '^"|"$', '')) AS is_support_trace,
         arrayFilter(x -> ifNull(notEquals(x, ''), 1), arrayDistinct(splitByChar(',', arrayStringConcat(groupArrayIf(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), and(equals(ai_events.event, '$ai_generation'), isNotNull(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), ifNull(notEquals(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_tools_called'), ''), 'null'), '^"|"$', '')), ''), 1))), ',')))) AS tools
  FROM ai_events
  WHERE and(equals(ai_events.team_id, 99999), and(in(ai_events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(greaterOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-14 23:50:00', 'UTC'))), lessOrEquals(toTimeZone(ai_events.timestamp, 'UTC'), assumeNotNull(toDateTime('2025-01-15 02:10:00', 'UTC'))))), in(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', ''), tuple('trace_project_1', 'trace_org_b', 'trace_org_a')))
  GROUP BY replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(ai_events.properties, '$ai_trace_id'), ''), 'null'), '^"|"$', '')
  ORDER BY first_timestamp DESC
  LIMIT 101
  OFFSET 0 SETTINGS readonly=2,
                    max_execution_time=60,
                    allow_experimental_object_type=1,
                    max_ast_elements=4000000,
                    max_expanded_ast_elements=4000000,
                    max_bytes_before_external_group_by=0,
                    transform_null_in=1,
                    optimize_min_equality_disjunction_chain_length=4294967295,
                    allow_experimental_join_condition=1,
                    use_hive_partitioning=0
  '''
# ---
# name: TestTracesQueryRunner.test_group_key_filter.2
  '''
  SELECT groupArray(trace_id) AS trace_ids,
         min(first_ts) AS min_timestamp,
